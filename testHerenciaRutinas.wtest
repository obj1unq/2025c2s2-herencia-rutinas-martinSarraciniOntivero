import herenciaRutinas.*


describe "Runing"{
            const rutinaRuning = new Running(intensidad = 1.2)
            const rutinaRuning2 = new Running(intensidad = 1.2)
    test "practicar 5 minutos"{
        assert.equals(360, rutinaRuning.caloriasBajadas(5))

    }
    test "practicar 90 minutos"{
        assert.equals(10200, rutinaRuning2.caloriasBajadas(90))

    }
}

describe "Maraton" {
           const maratonTest = new Maraton(intensidad = 1.5)
            const maratonTest2 = new Maraton(intensidad = 1.5)
  test "practicar 5 minutos" {
    assert.equals(900,   maratonTest.caloriasBajadas(5))
  }
  test "practicar 90 minutos" {
    assert.equals(25500,   maratonTest2.caloriasBajadas(90))
  }
}

